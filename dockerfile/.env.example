# Aliyun Kaggle continue-training workflow - environment variable configuration
# Usage: cp .env.example .env, then edit as needed

# ----------------------------------------------------------
# Kaggle
# ----------------------------------------------------------
# Kaggle competition name / dataset id
#   - competition example: geophysical-waveform-inversion
#   - dataset example:     liulong/geophysical-dataset
KAGGLE_COMPETITION=geophysical-waveform-inversion

# Download type: competition or dataset
KAGGLE_TYPE=competition

# Kaggle API token file path (default mounts ./kaggle-api/kaggle.json)
KAGGLE_CONFIG_DIR=/root/.kaggle

# ----------------------------------------------------------
# Path configuration
# ----------------------------------------------------------
# Host mount point of the ESSD (block device /dev/vdb -> /data). The same ESSD is
# mounted sequentially on the CPU and GPU machines at ${DATA_MOUNT}; the in-container
# data dirs are ${DATA_MOUNT}/kaggle/{input,working}
DATA_MOUNT=/data

# In-container paths (usually no need to change)
DOWNLOAD_DIR=/data/kaggle/input
WORKING_DIR=/data/kaggle/working

# ----------------------------------------------------------
# GPU container configuration
# ----------------------------------------------------------
# JupyterLab port mapping (host port:container port)
JUPYTER_PORT=8888

# Shared memory size (DataLoader multi-process needs it)
SHM_SIZE=16g

# NVIDIA GPU devices (all = expose all; or specify "0,1")
NVIDIA_VISIBLE_DEVICES=all

# ----------------------------------------------------------
# Aliyun ESSD mount info (block device; get the actual values from the console)
# ----------------------------------------------------------
# Attach the ESSD (e.g. /dev/vdb) to the CPU/GPU machine's disk manager, then:
#   sudo mkfs.ext4 /dev/vdb           # format on first use
#   sudo mkdir -p /data && sudo mount /dev/vdb /data
# Migration: umount+detach on the CPU machine -> attach on the GPU machine and mount /dev/vdb /data
