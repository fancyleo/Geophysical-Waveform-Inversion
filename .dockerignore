# Python environment and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.python-version

# VCS / IDE
.git/
.github/
.vscode/

# Large data / artifacts (must be excluded from the GPU build context to avoid sending hundreds of GB to the daemon)
input/
output/
# but always ship the augmentation-override file (sets "no augmentation" for training)
!output/aug_explore/
!output/aug_explore/winner_aug.json
stats/
kaggle_output/
nas/
dockerfile/nas/

# Secrets (never ship these into the image)
dockerfile/kaggle/
dockerfile/kaggle-api/
kaggle-api/

# Training artifacts / local debug notebook
*.pth
*.pt
*.ipynb_checkpoints/
working_space/test.ipynb
